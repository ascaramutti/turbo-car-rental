# TURBO — Environment variables template
#
# Copy this file to ".env" (in the same directory as docker-compose.yml)
# and fill in your own keys before running `docker compose up --build`.
#
# Never commit your real .env file.

# ---- Stripe (test mode) ----
# Get yours at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ---- Google Maps ----
# Get yours at: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Places API, Geocoding API
# Recommended: restrict the key to your domain and enable billing alerts.
# If left blank, the application will work but the map feature will not load.
VITE_GOOGLE_MAPS_API_KEY=
